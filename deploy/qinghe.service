[Unit]
Description=Qinghe virtual irrigation lab
After=network.target

[Service]
Type=simple
User=qinghe
WorkingDirectory=/opt/qinghe
EnvironmentFile=/opt/qinghe/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/qinghe/backend/src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
